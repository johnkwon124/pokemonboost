# research_agent
ANTHROPIC_API_KEY=sk-ant-your-key-here

# pokemon_stock — 모두 선택 사항 (config.yaml 값을 덮어씁니다)
# RedSky 공개 웹 키. 401/403이 날 때만 최신 값으로 교체하세요.
# TARGET_API_KEY=
# 감시할 TCIN (쉼표 또는 공백 구분)
# POKEMON_TCINS=94300072,89757321
# 픽업 감시용 매장 ID
# POKEMON_STORE_IDS=1234,5678
# POKEMON_INTERVAL_SECONDS=180
# POKEMON_STATE_FILE=.pokemon_stock_state.json

# 알림 채널
# POKEMON_WEBHOOK_URL=https://discord.com/api/webhooks/...
# POKEMON_DESKTOP_NOTIFY=true
# POKEMON_SMTP_HOST=smtp.gmail.com
# POKEMON_SMTP_PORT=587
# POKEMON_SMTP_USERNAME=you@gmail.com
# POKEMON_SMTP_PASSWORD=gmail-app-password
# POKEMON_EMAIL_TO=you@gmail.com
